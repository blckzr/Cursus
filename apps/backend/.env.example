# Copy this file to .env and fill in your values

# Supabase — use the POOLER connection string (port 6543, transaction mode)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# JWT — generate a strong random secret (e.g. openssl rand -hex 64)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h

# CORS — comma-separated list of allowed frontend origins.
#   dev:  http://localhost:5173
#   prod: https://cursus.vercel.app,https://cursus-staging.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Optional: regex matched against the Origin header. Useful for allowing
# Vercel preview deployments (per-PR URLs) without listing each one.
# Example: ^https:\/\/cursus-[a-z0-9-]+-myorg\.vercel\.app$
# CLIENT_ORIGIN_PATTERN=

# Server
PORT=4000
NODE_ENV=development
